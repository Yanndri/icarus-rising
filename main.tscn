[sub_resource type="GDScript" id="GDScript_oxdc4"]
resource_name = "BottomRightButtons"
script/source = "extends PanelContainer

@export var AlmanacFrame : Control
func _on_almanac_button_pressed() -> void:
	AlmanacFrame.visible = !AlmanacFrame.visible


func _on_shuffle_button_pressed() -> void:
	get_node(\"../../../NPCTextures\").randomize_textures()
"

